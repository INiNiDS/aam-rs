{
  "packages": {
    ".": {
      "release-type": "rust",
      "extra-files": [
        "Cargo.toml",
        "bindings/java/build.gradle.kts",
        "bindings/csharp/aam-csharp.csproj",
        "bindings/ruby/aam-ruby.gemspec",
        "bindings/js/package.json",
        {
          "type": "json",
          "path": "bindings/js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-darwin-arm64']"
        },
        {
          "type": "json",
          "path": "bindings/js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-linux-x64-gnu']"
        },
        {
          "type": "json",
          "path": "bindings/js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-win32-x64-msvc']"
        },
        {
          "type": "json",
          "path": "bindings/js/package.json",
          "jsonpath": "$.optionalDependencies['aam-nodejs-darwin-x64']"
        },
        {
          "type": "toml",
          "path": "bindings/js/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "bindings/ruby/ext/aam_rs/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "bindings/wasm/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "json",
          "path": "bindings/php/composer.json",
          "jsonpath": "$.version"
        },
        "bindings/csharp/CONTRIBUTING.md",
        "README.md"
      ]
    }
  }
}