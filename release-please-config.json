{
  "packages": {
    ".": {
      "release-type": "rust",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "Bug Fixes",
          "hidden": false
        },
        {
          "type": "refactor",
          "section": "Performance & Refactoring",
          "hidden": false
        }
      ]
    }
  },
  "extra-plugins": [
    {
      "type": "sentence-case"
    }
  ],
  "include-component-in-tag": false,
  "changelog-type": "default",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "types": {
    "refactor": {
      "changelog-section": "Performance & Refactoring",
      "release-type": "patch"
    }
  }
}