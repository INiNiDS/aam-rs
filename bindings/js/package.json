{
  "name": "aam-nodejs",
  "version": "2.4.1",
  "description": "Node.js bindings for the aam-rs AAML configuration parser",
  "license": "MIT OR Apache-2.0",
  "main": "loader.js",
  "types": "index.d.ts",
  "files": [
    "loader.js",
    "index.d.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "CREDITS.html"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "node --test"
  },
  "optionalDependencies": {
    "aam-nodejs-darwin-arm64": "2.4.1",
    "aam-nodejs-darwin-x64": "2.4.1",
    "aam-nodejs-linux-x64-gnu": "2.4.1",
    "aam-nodejs-win32-x64-msvc": "2.4.1"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "napi": {
    "binaryName": "aam_rs_node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  }
}




